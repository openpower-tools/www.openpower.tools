<opt:body xmlns:opt="https://www.openpower.tools/ns/opt">
      <p>
        The whole catalogue rendered live, side by side: each card carries a small
        example, and the full set of states and variants lives on the component's
        own page.
      </p>
      <opt:callout variant="note" heading="A living gallery">
        These examples are the real elements, rendered by the same wasm as everywhere
        else - flip the theme and they follow.
      </opt:callout>
      <h2>Content</h2>
      <div class="op-gallery">
        <opt:card heading="Callout" href="/component/callout/">
          <opt:callout variant="tip" heading="Tip">Hairline, watermark, wording.</opt:callout>
        </opt:card>
        <opt:card heading="Badge" href="/component/badge/">
          <p><opt:badge variant="ok">verified</opt:badge> <opt:badge variant="warning">stale</opt:badge> <opt:badge variant="info">upstream</opt:badge></p>
        </opt:card>
        <opt:card heading="Card" href="/component/card/">
          <opt:card heading="A nested card">Titled containers with optional link headings and footers.</opt:card>
        </opt:card>
        <opt:card heading="Details" href="/component/details/">
          <opt:details summary="Serial console settings">115200 8N1, from the BMC.</opt:details>
        </opt:card>
        <opt:card heading="Key-value" href="/component/key-value/">
          <opt:key-value><dl><dt>CPU</dt><dd>POWER9 Sforza</dd><dt>BMC</dt><dd>AST2500</dd></dl></opt:key-value>
        </opt:card>
        <opt:card heading="Table" href="/component/table/">
          <opt:table dense="" lined="">
            <table>
              <thead><tr><th>Part</th><th>Size</th></tr></thead>
              <tbody><tr><td>HBB</td><td>512 KiB</td></tr><tr><td>PAYLOAD</td><td>1 MiB</td></tr></tbody>
            </table>
          </opt:table>
        </opt:card>
        <opt:card heading="Source" href="/component/source/">
          <opt:source label="shell">
<pre>pflash -i</pre>
          </opt:source>
        </opt:card>
        <opt:card heading="Timeline" href="/component/timeline/">
          <opt:timeline>
            <ol>
              <li data-status="ok"><time>2026-08</time>Site live.</li>
              <li data-status="info"><time>2026-09</time>Gallery lands.</li>
            </ol>
          </opt:timeline>
        </opt:card>
        <opt:card heading="Empty state" href="/component/empty-state/">
          <opt:empty-state heading="Nothing here yet"><p>And it says so, plainly.</p></opt:empty-state>
        </opt:card>
        <opt:card heading="KPI" href="/component/kpi/">
          <p>
            <opt:kpi label="CPU temp" value="52" unit="°C" state="ok"></opt:kpi>
            <opt:kpi label="Fan" value="4,120" unit="rpm"></opt:kpi>
          </p>
        </opt:card>
        <opt:card heading="Steps" href="/component/steps/">
          <opt:steps>
            <ol>
              <li data-state="done">Back up the PNOR.</li>
              <li data-state="current">Flash the image.</li>
            </ol>
          </opt:steps>
        </opt:card>
        <opt:card heading="Tree" href="/component/tree/">
          <opt:tree>
            <ul><li><details open=""><summary>PNOR</summary><ul><li><code>HBB</code> 512 KiB</li></ul></details></li></ul>
          </opt:tree>
        </opt:card>
      </div>
      <h2>Controls</h2>
      <div class="op-gallery">
        <opt:card heading="Button" href="/component/button/">
          <p><opt:button>Default</opt:button> <opt:button variant="primary">Primary</opt:button></p>
        </opt:card>
        <opt:card heading="Input" href="/component/input/">
          <opt:input><label>BMC address <input type="text" placeholder="bmc.talos.local"/></label></opt:input>
        </opt:card>
        <opt:card heading="Select" href="/component/select/">
          <opt:select><label>Channel <select><option>Raptor stock</option><option>Upstream</option></select></label></opt:select>
        </opt:card>
        <opt:card heading="Checkbox" href="/component/checkbox/">
          <opt:checkbox><label><input type="checkbox" checked=""/> Petitboot autoboot</label></opt:checkbox>
        </opt:card>
        <opt:card heading="Switch" href="/component/switch/">
          <opt:switch><label><input type="checkbox" checked=""/> Follow the system theme</label></opt:switch>
        </opt:card>
        <opt:card heading="Tooltip" href="/component/tooltip/">
          <p>The <opt:tooltip text="Processor NOR flash"><a href="#">PNOR</a></opt:tooltip> holds the boot firmware.</p>
        </opt:card>
        <opt:card heading="Chip" href="/component/chip/">
          <p><opt:chip toggle="" pressed="" variant="info">POWER9</opt:chip> <opt:chip removable="">talos-ii</opt:chip></p>
        </opt:card>
        <opt:card heading="Progress" href="/component/progress/">
          <opt:progress label="Flashing" value="62"></opt:progress>
        </opt:card>
        <opt:card heading="Build status">
          <opt:build-status></opt:build-status>
        </opt:card>
      </div>
      <h2>Navigation</h2>
      <div class="op-gallery">
        <opt:card heading="Tabs" href="/component/tabs/">
          <opt:tabs>
            <opt:tab label="Debian"><p>ppc64el netinst.</p></opt:tab>
            <opt:tab label="Fedora"><p>Server for ppc64le.</p></opt:tab>
          </opt:tabs>
        </opt:card>
        <opt:card heading="Breadcrumb" href="/component/breadcrumb/">
          <opt:breadcrumb>
            <ol><li><a href="/">Home</a></li><li><a href="/components/" aria-current="page">Components</a></li></ol>
          </opt:breadcrumb>
        </opt:card>
        <opt:card heading="Pagination" href="/component/pagination/">
          <opt:pagination>
            <ol><li><a href="#">1</a></li><li><a href="#" aria-current="page">2</a></li><li><a href="#">3</a></li></ol>
          </opt:pagination>
        </opt:card>
      </div>
      <h2>Immersive</h2>
      <div class="op-gallery">
        <opt:card heading="Scene" href="/component/scene/">
          <p>Embedded A-Frame scenes with Rust-driven behaviour. The 1.3 MB runtime
          loads lazily, only on pages containing the element, so the live example
          stays on its own page.</p>
        </opt:card>
      </div>

</opt:body>
