<opt:body xmlns:opt="https://www.openpower.tools/ns/opt">
      <p>A labelled native select, styled with the theme tokens.</p>
      <h2>Example</h2>
      <opt:select>
        <label>Firmware release channel
        <select>
          <option>Raptor stock</option>
          <option>Upstream OpenBMC</option>
          <option>Custom build</option>
        </select></label>
      </opt:select>
      <h2>Markup</h2>
      <pre>&lt;opt:select&gt;
  &lt;label&gt;Firmware release channel
  &lt;select&gt;&lt;option&gt;Raptor stock&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;
&lt;/opt:select&gt;</pre>

</opt:body>
